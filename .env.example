# Application Environment
APP_ENV=development
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000

# Assistant Identity
ASSISTANT_NAME=NOVA
DEFAULT_PERSONALITY=Futuristic
DEFAULT_LANGUAGE=en

# OpenAI Configuration
# Provide your real OpenAI API key. If left blank or "your_api_key_here",
# the assistant operates in resilient simulation mode.
OPENAI_API_KEY=your_api_key_here
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy

# Database & Storage
DATABASE_PATH=data/nova.db
AUDIO_DIR=data/audio
UPLOAD_DIR=data/uploads
MAX_UPLOAD_SIZE_MB=10
